{
  "name": "my-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "velite build --clean && next build",
    "start": "next start",
    "preview": "npm run build && next start",
    "lint": "eslint .",
    "typecheck": "velite build --clean && tsc --noEmit",
    "content": "velite build --clean",
    "content:watch": "velite --watch"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "geist": "1.7.2",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "schema-dts": "2.0.0",
    "sharp": "0.35.3",
    "shiki": "4.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "velite": "0.4.0"
  },
  "comments": {
    "overrides": "velite 0.4.0 depends on sharp ^0.34.5, which has open libvips CVEs (GHSA-f88m-g3jw-g9cj). $sharp pins velite's copy to the version in devDependencies."
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
